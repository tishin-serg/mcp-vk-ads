{
  "name": "mcp-vk-ads",
  "version": "1.5.1",
  "private": true,
  "description": "Hardened fork of the VK Ads MCP server for controlled AI access to live advertising accounts.",
  "mcpName": "io.github.tishin-serg/mcp-vk-ads-hardened",
  "type": "module",
  "bin": {
    "mcp-vk-ads": "dist/index.js"
  },
  "files": [
    "dist",
    "test",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/index.js",
    "auth:setup": "node dist/setup-auth.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "npm run test:src && npm run test:dist",
    "test:src": "node scripts/run-src-tests.mjs",
    "test:dist": "npm run build && node --test test/dist-smoke.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "version": "npm shrinkwrap && git add npm-shrinkwrap.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vk",
    "vk-ads",
    "advertising"
  ],
  "license": "MIT",
  "author": "Aleksandr Kovalko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishin-serg/mcp-vk-ads.git"
  },
  "homepage": "https://github.com/tishin-serg/mcp-vk-ads#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
